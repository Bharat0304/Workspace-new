# ============================================================
# WorkSpace — .gitignore
# ============================================================

# ---- Dependencies ------------------------------------------
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ---- Virtual Environments ----------------------------------
venv/
.venv/
*/venv/
*/.venv/
ENV/
env/

# ---- Backups & Temporary -----------------------------------
frontend_backup/
*.backup
*.bak

# ---- Environment -------------------------------------------
.env
.env.local
.env.development.local
.env.staging.local
.env.production.local
.env.*.local

# ---- Build Artifacts ---------------------------------------
dist/
build/
out/
.next/
.nuxt/
.cache/
.turbo/

# ---- Logs --------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS Files ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editor Configs ----------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Python ------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg
*.egg-info/
*.pyc

# ---- Electron / Binaries -----------------------------------
dist-electron/
*.dmg
*.exe
*.AppImage
*.snap
